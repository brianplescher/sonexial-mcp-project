# Sonexial Author MCP Configuration
# Copy this file to .env and adjust values

# Environment: development, staging, production
SONEXIAL_MCP_ENV=development

# HTTP server settings
SONEXIAL_MCP_HOST=0.0.0.0
SONEXIAL_MCP_PORT=8080

# Database
# SQLite (development). Must use the async driver (+aiosqlite).
# Use an absolute path when launched from Claude Desktop, whose working directory is not this repo.
SONEXIAL_MCP_DATABASE_URL=sqlite+aiosqlite:///./sonexial.db
# PostgreSQL (production):
# SONEXIAL_MCP_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sonexial_mcp

# Authentication
# Required for HTTP transport (unless SONEXIAL_MCP_AUTH_DISABLED=true)
SONEXIAL_MCP_API_KEY=change-me-to-a-secure-random-string
# Public hostname(s) allowed in the Host header (DNS rebinding protection). Set to your domain in production.
SONEXIAL_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
SONEXIAL_MCP_AUTH_DISABLED=true

# Logging
SONEXIAL_MCP_LOG_LEVEL=INFO

# CORS (comma-separated origins, or * for all)
SONEXIAL_MCP_CORS_ORIGINS=*
