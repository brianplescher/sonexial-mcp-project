# Sonexial Author MCP Configuration
# Copy this file to .env and adjust values

# Environment: development, staging, production
SONEXIAL_MCP_ENV=development

# HTTP server settings
SONEXIAL_MCP_HOST=0.0.0.0
SONEXIAL_MCP_PORT=8080

# Database
# SQLite (development):
DATABASE_URL=sqlite:///./sonexial.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/sonexial_mcp

# Authentication
# Required for HTTP transport (unless AUTH_DISABLED=true)
SONEXIAL_MCP_API_KEY=change-me-to-a-secure-random-string
AUTH_DISABLED=true

# Logging
LOG_LEVEL=INFO

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*
